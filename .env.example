# ==========================================================
# AuraStudio - Variáveis de Ambiente
# Copie este arquivo para .env.local para rodar localmente
# ou configure no painel da Vercel em Settings -> Environment Variables
# ==========================================================

# 1. Inteligência Artificial (Google Gemini)
# Obtenha gratuitamente em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Banco de Dados Postgres (Neon / Supabase / Vercel Postgres)
# Se vazio localmente, o app usa automaticamente o arquivo local data/store.json
DATABASE_URL=

# 3. Armazenamento de Mídia na Nuvem (Vercel Blob)
# Se vazio localmente, o app salva imagens em public/uploads/
BLOB_READ_WRITE_TOKEN=

# 4. Segurança para disparo manual / webhook opcional e sessões de login
PUBLISHER_SECRET=troque-por-um-segredo-forte
AUTH_SECRET=troque-por-uma-chave-secreta-aleatoria-de-32-caracteres

# 5. URL pública da aplicação (usada pelas APIs da Meta/TikTok para baixar mídias e OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 6. OAuth com Login Unificado do Instagram (sem precisar de Página do Facebook)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_CONFIG_ID=

# 7. OAuth com 1 clique - Meta (Instagram + Facebook)
# Crie um app em https://developers.facebook.com/apps
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=

# 7. OAuth com 1 clique - TikTok Content Posting API
# Crie um app em https://developers.tiktok.com/apps
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
